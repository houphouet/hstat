## Fichier de citation du package HStat.
## Lu automatiquement par citation("HStat") et toRfBibtex().

citHeader("Pour citer le package HStat dans vos publications, utilisez :")

## Version et annee suivent automatiquement DESCRIPTION.
## `meta` est fourni par R a la lecture de ce fichier et contient les champs de
## DESCRIPTION : c'est la source la plus fiable, disponible meme quand
## packageVersion() ne l'est pas encore (lecture pendant l'installation).
vers <- if (!is.null(meta$Version) && nzchar(meta$Version)) {
  meta$Version
} else {
  tryCatch(as.character(utils::packageVersion("HStat")),
           error = function(e) "")
}

year <- tryCatch(
  sub("-.*", "", utils::packageDate("HStat")),
  error = function(e) NA_character_
)
if (is.null(year) || is.na(year) || !nzchar(year)) {
  year <- if (!is.null(meta$Date) && nzchar(meta$Date)) {
    sub("-.*", "", meta$Date)
  } else {
    format(Sys.Date(), "%Y")
  }
}

## Les AUTEURS suivent eux aussi DESCRIPTION -- champ `Authors@R`, fourni par R
## dans `meta`. La liste etait recopiee ici, et les trois copies avaient
## diverge : le message de demarrage et l'onglet de citation ne nommaient qu'un
## auteur sur deux, celle-ci les deux. Une liste recopiee finit par diverger, et
## c'est la copie oubliee qui ment.
##
## Ce fichier ne peut pas appeler le socle : readCitationFile() le lit pendant
## l'installation, avant que l'espace de noms de HStat soit chargeable. C'est
## donc la MISE EN FORME qui est reecrite ici -- jamais les noms.
##
## `Authors@R` est du code R ; `Author`, s'il existe, en est la forme deja
## composee par R et sert de repli.
auteurs <- tryCatch(eval(parse(text = meta[["Authors@R"]])),
                    error = function(e) NULL)
if (!inherits(auteurs, "person") || !length(auteurs)) {
  auteurs <- tryCatch(utils::as.person(meta$Author), error = function(e) NULL)
}

## Seuls les auteurs sont cites : un detenteur de droits ou un contributeur
## figure legitimement dans DESCRIPTION sans etre auteur de la publication.
if (inherits(auteurs, "person") && length(auteurs)) {
  roles <- vapply(auteurs, function(p) paste(p$role, collapse = " "), character(1))
  garde <- grepl("\\baut\\b|\\bcre\\b", roles)
  if (any(garde)) auteurs <- auteurs[garde]
}

titre <- "HStat : Application Shiny interactive pour l'analyse statistique"
url   <- "https://github.com/houphouet/hstat"
ok    <- inherits(auteurs, "person") && length(auteurs) > 0L

## Aucun auteur resolu : on n'en invente pas, et on ne fait pas tomber
## citation("HStat") pour autant. @Manual n'exige que son titre ; sans
## textVersion, R compose la phrase depuis l'entree elle-meme.
##
## "Claude Code" n'a pas de nom de famille : person() range le nom d'un seul
## tenant dans `given`, et l'inverser rendrait "Code, Claude" -- un auteur qui
## n'existe pas. Il ressort donc tel quel.
liste <- if (ok) {
  noms <- vapply(auteurs, function(p) {
    fam <- paste(p$family, collapse = " ")
    giv <- paste(p$given,  collapse = " ")
    if (!nzchar(fam)) giv else if (!nzchar(giv)) fam else paste0(fam, ", ", giv)
  }, character(1))
  if (length(noms) > 1L) {
    paste0(paste(noms[-length(noms)], collapse = ", "), " & ", noms[length(noms)])
  } else {
    noms
  }
} else {
  NULL
}

args <- c(
  list(bibtype = "Manual", title = titre),
  if (ok) list(author = auteurs) else NULL,
  list(year = year, note = paste0("Version ", vers), url = url, key = "hstat"),
  if (ok) list(textVersion = paste0(liste, " (", year, "). ", titre,
                                    ". Version ", vers, ". ", url)) else NULL)

do.call(bibentry, args)
