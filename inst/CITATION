## Fichier de citation du package HStat.
## Lu automatiquement par citation("HStat") et toRfBibtex().

citHeader("Pour citer le package HStat dans vos publications, utilisez :")

## Version et annee suivent automatiquement DESCRIPTION.
## `meta` est fourni par R a la lecture de ce fichier et contient les champs de
## DESCRIPTION : c'est la source la plus fiable, disponible meme quand
## packageVersion() ne l'est pas encore (lecture pendant l'installation).
vers <- if (!is.null(meta$Version) && nzchar(meta$Version)) {
  meta$Version
} else {
  tryCatch(as.character(utils::packageVersion("HStat")),
           error = function(e) "")
}

year <- tryCatch(
  sub("-.*", "", utils::packageDate("HStat")),
  error = function(e) NA_character_
)
if (is.null(year) || is.na(year) || !nzchar(year)) {
  year <- if (!is.null(meta$Date) && nzchar(meta$Date)) {
    sub("-.*", "", meta$Date)
  } else {
    format(Sys.Date(), "%Y")
  }
}

bibentry(
  bibtype  = "Manual",
  title    = paste0("HStat : Application Shiny interactive pour l'analyse statistique"),
  author   = person("Houphouet", "KOUADIO",
                    comment = c(ORCID = "0000-0002-8238-1091")),
  year     = year,
  note     = paste0("Version ", vers),
  url      = "https://github.com/houphouet/hstat",
  key      = "hstat",
  textVersion = paste0(
    "KOUADIO, Houphouet (", year, "). ",
    "HStat : Application Shiny interactive pour l'analyse statistique. ",
    "Version ", vers, ". https://github.com/houphouet/hstat"
  )
)
